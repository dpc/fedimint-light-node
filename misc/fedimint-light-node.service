# Example only. Provision user, bound store and CURRENT operator evidence first.
[Unit]
Description=Bounded Bitcoin header node (manual guardian coordination)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fedimint-light-node
Group=fedimint-light-node
StateDirectory=fedimint-light-node
StateDirectoryMode=0700
UMask=0077
# Non-secret GUARDIAN_ID, COMMITTED_HEIGHT, COMMITTED_HASH, OLDEST_NEEDED, CAPACITY.
EnvironmentFile=/etc/fedimint-light-node/operator.env
LoadCredential=rpc.auth:/etc/fedimint-light-node/rpc.auth
ExecStart=/opt/fedimint-light-node/bin/fedimint-light-node --db /var/lib/fedimint-light-node/chain.redb --capacity ${CAPACITY} --guardian-id ${GUARDIAN_ID} serve --committed-height ${COMMITTED_HEIGHT} --committed-hash ${COMMITTED_HASH} --oldest-needed ${OLDEST_NEEDED} --rpc-credentials %d/rpc.auth --fake-bitcoind
Restart=no
KillSignal=SIGTERM
TimeoutStopSec=15
SendSIGKILL=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
